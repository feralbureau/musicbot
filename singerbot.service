[Unit]
Description=SingerBot - Telegram Voice Chat Music Bot
After=network.target

[Service]
Type=simple
# Customize the paths below to match your installation:
#   WorkingDirectory  -> directory containing bot.py
#   EnvironmentFile  -> path to your .env file
#   ExecStart        -> /usr/bin/python3 /path/to/bot.py
# Consider creating a dedicated system user instead of running as root.
User=botuser
WorkingDirectory=/opt/singerbot
EnvironmentFile=/opt/singerbot/.env
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /opt/singerbot/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
